# Spring Boot Backend
SERVER_PORT=8080
DATABASE_URL=jdbc:mysql://localhost:3306/colorectal_ai?createDatabaseIfNotExist=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password
JWT_SECRET_KEY=your-very-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MODELS_DIR=models
MAX_UPLOAD_MB=10

# Admin Bootstrap (used by CommandLineRunner on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_admin_password
ADMIN_NAME=Administrator

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api

# FastAPI ML Service
ML_SERVICE_PORT=8000
SEGMENTATION_MODEL_PATH=ML_API/best_segmentation_model.pth
CLASSIFICATION_MODEL_PATH=ML_API/best_classifier_model_v3.pth
PYTORCH_DEVICE=cuda  # or cpu
LOG_LEVEL=INFO

# MySQL (if using docker-compose)
MYSQL_ROOT_PASSWORD=secure_root_password
MYSQL_DATABASE=colorectal_ai
MYSQL_USER=colovision
MYSQL_PASSWORD=secure_user_password